# syntax=docker/dockerfile:1.6
FROM alpine:3.19

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH="/opt/venv/bin:$PATH"

RUN apk add --no-cache \
        python3 py3-pip python3-dev \
        gcc g++ musl-dev make cmake cargo rust linux-headers \
        bash git curl wget vim nano \
        libffi-dev openssl-dev libpcap-dev \
        jpeg-dev zlib-dev freetype-dev \
        libx11-dev libxtst-dev libxext-dev \
        iputils bind-tools traceroute mtr \
        nmap nmap-scripts netcat-openbsd socat whois \
        openssh-client openssl \
        chromium chromium-chromedriver \
        docker-cli docker-cli-compose \
        tini procps htop jq yq tcpdump

RUN python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --upgrade pip setuptools wheel

WORKDIR /app

COPY requirements.txt /app/
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir watchdog pytest pytest-cov black flake8 mypy

COPY . /app/

EXPOSE 5000 4444 5555 8080

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["python3", "-u", "/app/nemesis_crab_v2.py"]
